{
  "name": "dance-academy-app-server",
  "version": "1.0.0",
  "description": "Backend for the Dance Academy application using Express and MongoDB",
  "main": "src/index.ts",
  "scripts": {
    "prestart": "npm run build",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "prod": "pm2 start ecosystem.config.js",
    "restart": "pm2 restart dance-backend",
    "test": "jest",
    "mongo:ping": "node scripts/mongo-ping.js"
  },
  "dependencies": {
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^8.2.0",
    "express": "^4.17.1",
    "jsonwebtoken": "^8.5.1",
    "mongodb": "^7.0.0",
    "mongoose": "^7.8.8",
    "multer": "^1.4.2",
    "pm2": "^6.0.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.2",
    "@types/cors": "^2.8.10",
    "@types/express": "^4.17.8",
    "@types/jest": "^26.0.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.10.2",
    "@types/multer": "^2.0.0",
    "jest": "^26.6.3",
    "nodemon": "^3.1.11",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "dance",
    "academy",
    "express",
    "mongodb"
  ],
